    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.14.1",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "postcss": "^8.5.14",
    "postcss-load-config": "^6.0.1",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
